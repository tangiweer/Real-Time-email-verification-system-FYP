
REQUIRE_AUTH=true

API_KEYS=your-api-key-here
REDIS_PASSWORD=your-redis-password-here
SESSION_TOKEN_SECRET=your-session-token-secret-here

SMTP_FROM_ADDRESS=verification@example.com
SMTP_EHLO_HOST=mail.example.com

OUTBOUND_SMTP_HOST=smtp.example.com
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_FROM=verification@example.com
OUTBOUND_SMTP_USERNAME=your-smtp-username-here
OUTBOUND_SMTP_PASSWORD=your-smtp-password-here
PUBLIC_APP_URL=http://localhost:8000
COOKIE_SECURE=false

# Local presentation/testing only. Set to 1 when you do not have a real SMTP
# relay configured; it simulates a successful recipient check. Keep 0 for a
# real deployment.
MOCK_SMTP=1
